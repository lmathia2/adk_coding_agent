# Model chosen by the current Agents CLI 1.4.1 scaffold.
ADK_CODING_MODEL=gemini-3.7-flash

# Optional declarative composition. For Magnitude, copy/update examples/magnitude.yaml.
# ADK_CODING_CONFIG=/absolute/path/to/harness.yaml
# MAGNITUDE_API_KEY=magnitude-local

# Repository the coding agent is allowed to operate on.
ADK_CODING_WORKSPACE=/absolute/path/to/repository

# Full command/test output is stored here; bounded summaries go to the model.
ADK_CODING_ARTIFACTS=.artifacts

# Native indexed discovery behind bash: auto | fff | disabled.
ADK_CODING_SEARCH_BACKEND=auto

# Privacy-safe interaction tracing: off | metadata | redacted.
ADK_CODING_TRACE_MODE=metadata
ADK_CODING_TRACE_MAX_CONTENT_BYTES=8192

# Optional additional Agent Skills roots, separated by the platform path separator.
# ADK_CODING_SKILL_DIRS=/absolute/team/skills:/absolute/personal/skills
ADK_CODING_SKILL_MAX_SELECTED=3
ADK_CODING_SKILL_CONTEXT_BYTES=24000

# Verified-trace learning. Candidates are trialed deterministically before promotion.
ADK_CODING_LEARNING_ENABLED=1
ADK_CODING_LEARNING_MIN_SUPPORT=3
ADK_CODING_LEARNING_TRIAL_PERCENT=20

# deny | allowlist | allow. The MVP defaults to deny.
ADK_CODING_NETWORK=deny

# Optional Google configuration.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_API_KEY=
