# Model chosen by the current Agents CLI 1.4.1 scaffold.
ADK_CODING_MODEL=gemini-3.7-flash

# Repository the coding agent is allowed to operate on.
ADK_CODING_WORKSPACE=/absolute/path/to/repository

# Full command/test output is stored here; bounded summaries go to the model.
ADK_CODING_ARTIFACTS=.artifacts

# deny | allowlist | allow. The MVP defaults to deny.
ADK_CODING_NETWORK=deny

# Optional Google configuration.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_API_KEY=
