# Agents CLI invocation identity. Behavior belongs in YAML, not environment overrides.
ADK_CODING_WORKSPACE=/absolute/path/to/repository
# ADK_CODING_CONFIG=/absolute/path/to/harness.yaml
# ADK_CODING_STATE_DIR=/absolute/path/to/run-state
# ADK_CODING_TRUST_PROJECT=1  # only after reviewing project instructions and skills

# The convenience launcher uses a shared root for credentials and per-run state.
# ADK_CODING_AGENT_STATE_ROOT=/absolute/path/to/shared-state

# Native Gemini credentials (not needed for Codex subscription login).
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True
