#!/bin/sh
set -eu

script_path=$0
links=0
while [ -L "$script_path" ]; do
  links=$((links + 1)); [ "$links" -le 20 ] || {
    printf 'error: terminal launcher symlink chain is too deep\n' >&2; exit 1;
  }
  target=$(readlink "$script_path")
  case "$target" in
    /*) script_path=$target ;;
    *) script_path=$(dirname -- "$script_path")/$target ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script_path")/../.." && pwd -P)
entrypoint=$root/clients/terminal/dist/src/main.js
[ -f "$entrypoint" ] || {
  printf 'error: Pi-style terminal is not built; run npm run build --prefix %s/clients/terminal\n' "$root" >&2
  exit 1
}
exec node "$entrypoint" "$@"
